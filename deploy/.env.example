# LedgerPilot compose 环境变量（复制为 deploy/..env）
# ── 必填 ──
JWT_SECRET=change-me-to-a-random-string-32-chars-minimum
MYSQL_ROOT_PASSWORD=change-me
LEDGERPILOT_API_TOKEN=change-me   # 前端反代/后端 → AI 服务的共享 token

# ── 可选（demo 档全留空 = AI 走规则层，无需任何 LLM key）──
DEEPSEEK_API_KEY=
DASHSCOPE_API_KEY=
ZHIPU_API_KEY=                  # RAG embedding；空 = RAG 关闭
LEDGERPILOT_INTERNAL_TOKEN=       # AI 回调后端内部接口的共享密钥（费率注入用）
