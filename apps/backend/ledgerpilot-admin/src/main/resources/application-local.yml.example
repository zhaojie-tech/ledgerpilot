# 本地开发配置模板：复制为 application-local.yml 并以 --spring.profiles.active=local 启动。
# 该文件已被 .gitignore 排除，真实凭据只存在于本地，禁止入库。

spring:
  datasource:
    url: jdbc:mysql://localhost:3306/ledgerpilot?useUnicode=true&characterEncoding=UTF-8&serverTimezone=Asia/Shanghai
    username: root
    password: change-me-local

# 生产/联调必填（也可以用环境变量注入，见 README 配置表）：
# JWT_SECRET: ≥32 字符随机串
# LEDGERPILOT_INTERNAL_TOKEN: 与 AI 服务共享的内部密钥
# LEDGERPILOT_API_TOKEN: AI 服务的访问 token（AI 侧开启鉴权时）
