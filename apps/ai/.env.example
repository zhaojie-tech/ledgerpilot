# LedgerPilot AI Service 配置模板
# 复制为 .env 并按需填写。所有条目均可省略——省略时服务以「无 key 降级」方式启动。

# ─── LLM 提供商（OpenAI 兼容协议；key 留空 = 该提供商自动禁用）───
DASHSCOPE_API_KEY=
DEEPSEEK_API_KEY=

# ─── RAG 知识检索（智谱 Embedding；key 留空 = RAG 检索自动关闭，解析不受影响）───
ZHIPU_API_KEY=

# ─── API 鉴权（生产部署必须设置；留空 = 无鉴权开放，启动时打印 WARNING，仅限本地开发）───
LEDGERPILOT_API_TOKEN=
# 开发机可设 true：本机 127.0.0.1/::1 请求免 token
LEDGERPILOT_AUTH_ALLOW_LOCAL=false

# ─── CORS 白名单（逗号分隔来源；留空 = 不输出 CORS 头，服务端调用不受影响）───
# 示例：CORS_ORIGINS=https://your-app.example.com,http://localhost:8080
CORS_ORIGINS=
# 仅当 CORS_ORIGINS 为显式白名单（不含 *）时才建议开启
CORS_ALLOW_CREDENTIALS=false

# ─── options.model 白名单（逗号分隔；防止调用方指定任意模型烧 key）───
# 默认 deepseek-chat,qwen-plus；自建 OpenAI 兼容端点时改成你的模型名，显式留空 = 不限制
ALLOWED_MODELS=deepseek-chat,qwen-plus

# ─── 可选内部依赖：确定性费率注入（社保/公积金/税率等，来自你的 Java 后端）───
# 留空 = 关闭注入，解析照常工作。接口约定见 docs（后续里程碑补充）
JAVA_BACKEND_URL=

# ─── 存储路径（默认仓库内 data/ 与 knowledge/，均已 gitignore）───
CHROMA_PERSIST_DIR=
KNOWLEDGE_DIR=

# ─── RAG 检索参数 ───
RAG_TOP_K=5
RAG_RELEVANCE_THRESHOLD=0.3
